node -e '
const fs = require("fs");
let code = fs.readFileSync("src/index.ts", "utf8");
const rotaPost = `
app.post("/products", async (req, res) => {
  try {
    const { name, description, price, stock, imageUrl } = req.body;
    let cat = await prisma.category.findFirst();
    if (!cat) cat = await prisma.category.create({ data: { name: "Geral" } });
    const product = await prisma.product.create({
      data: {
        name,
        description: description || "",
        price: Number(price),
        stock: Number(stock) || 10,
        imageUrl: imageUrl || null,
        categoryId: cat.id
      }
    });
    res.status(201).json(product);
  } catch (e) {
    res.status(400).json({ error: String(e) });
  }
});
`;
if (!code.includes("app.post(\"/products\"") && !code.includes("app.post(\x27/products\x27")) {
  code = code.replace("app.listen(", rotaPost + "\napp.listen(");
  fs.writeFileSync("src/index.ts", code);
  console.log("Rota POST /products adicionada!");
}
' && npm run build
